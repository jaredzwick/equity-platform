# Copy to landing/.env.local for local dev; set as Vercel env vars in prod.

# GitHub App (reuses the same App as console/ — add web callback URL under
# github.com/settings/apps/<app>/edit → "Callback URL":
#   https://<vercel-domain>/api/auth/callback
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx

# Client secret is required for the web OAuth flow. Generate under the App's
# settings page → "Client secrets" → "Generate a new client secret".
# The console's device flow does NOT need this.
GITHUB_APP_CLIENT_SECRET=

# The App slug — the URL name at github.com/apps/<slug>. Used to construct
# the "Install App on your fork" link. Should match the console's APP_SLUG.
GITHUB_APP_SLUG=equity-console

# Iron-session cookie signing password. Any 32+ character string. Use a
# different value per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=

# The repo users fork on first sign-in. owner/name form.
UPSTREAM_REPO=jaredzwick/equity-platform

# Public site URL — used to build the OAuth redirect_uri. Must match a
# Callback URL registered on the GitHub App.
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Pypes Go API origin. /deal/[slug] and /sitemap.xml fetch enriched deal
# data from GET /lamboapp/public/deals/{slug} and GET /lamboapp/public/deals
# on this host. Same pattern careerjumpship uses for its /jobs/[slug] pages.
# No DATABASE_URL needed — the Go API owns Postgres access.
NEXT_PUBLIC_PYPES_API_URL=https://api.pypes.dev

# Shared bearer for the pypes /lamboapp/buyers/* proxy endpoints. Must
# match LAMBOAPP_FRONTEND_BEARER on the Go server (set as a GitHub Actions
# secret on jaredzwick/pypes). Server-only — never expose to client code.
# Used by /api/auth/callback (upsert-by-github) and /api/buyer/* proxy
# routes to prove the request originated from this frontend.
LAMBOAPP_BACKEND_BEARER=

# Cloudflare Turnstile site key for the /sell page's draft-creation form
# (2026-08-04, $7 seller listing flow). Get one at
# https://dash.cloudflare.com/?to=/:account/turnstile.
# For local dev, use the Cloudflare-provided always-pass test key:
#   1x00000000000000000000AA  — always passes
#   2x00000000000000000000AB  — always fails (negative tests)
# Server-side verification runs in pypes (TURNSTILE_SECRET on that side).
# Leaving empty in dev also works: the frontend skips the widget with a
# banner note; the server may still 403 if it requires a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

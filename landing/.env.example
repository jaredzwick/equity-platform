# Copy to landing/.env.local for local dev; set as Vercel env vars in prod.

# GitHub App (reuses the same App as console/ — add web callback URL under
# github.com/settings/apps/<app>/edit → "Callback URL":
#   https://<vercel-domain>/api/auth/callback
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx

# Client secret is required for the web OAuth flow. Generate under the App's
# settings page → "Client secrets" → "Generate a new client secret".
# The console's device flow does NOT need this.
GITHUB_APP_CLIENT_SECRET=

# The App slug — the URL name at github.com/apps/<slug>. Used to construct
# the "Install App on your fork" link. Should match the console's APP_SLUG.
GITHUB_APP_SLUG=equity-console

# Iron-session cookie signing password. Any 32+ character string. Use a
# different value per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=

# The repo users fork on first sign-in. owner/name form.
UPSTREAM_REPO=jaredzwick/equity-platform

# Public site URL — used to build the OAuth redirect_uri. Must match a
# Callback URL registered on the GitHub App.
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Postgres connection for the /deal/[slug] SSR page + sitemap. Must point at
# the same Postgres the n8n workflow "Deal Sourcer" writes into (deals table).
# Use a pooled endpoint (pgbouncer) in production — Vercel serverless.
#   postgres://user:pass@host:6432/db?sslmode=require
DATABASE_URL=

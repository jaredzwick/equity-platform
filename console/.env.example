# Copy this to console/.env.local (gitignored) and fill in.

# ─── NATS monitoring ────────────────────────────────────────────────────
# Local dev: kubectl port-forward -n nats svc/nats-headless 8222:8222
# In-cluster: NATS_MONITOR_URL=http://nats-headless.nats.svc.cluster.local:8222
NATS_MONITOR_URL=http://localhost:8222

# ─── GitOps writeback (New Application / History pages) ─────────────────
# Fine-grained PAT with contents:write on the platform repo.
# Create at: https://github.com/settings/personal-access-tokens/new
# Scope: single repository (jaredzwick/equity-platform), Contents: Read and write.
GITHUB_TOKEN=

# owner/name of the platform repo the console commits to.
GITHUB_REPO=jaredzwick/equity-platform

# Branch to commit to. Default: main.
# Recommended: use a "console-provisions" branch + PR flow if you want a
# human review step before ArgoCD picks up the change.
GITHUB_BRANCH=main

# ─── Per-tenant email deliverability (future) ────────────────────────────
# One EMAIL_DB_URL per tenant, keyed by uppercase slug.
# Example: EMAIL_DB_URL_PYPES=postgres://user:pass@host:5432/pypes
# EMAIL_DB_URL_PYPES=
# EMAIL_DB_URL_HIRINGFUNNEL=
# EMAIL_DB_URL_CJS=

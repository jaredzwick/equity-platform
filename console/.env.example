# Copy this to console/.env.local (gitignored) and fill in.

# ─── NATS monitoring ────────────────────────────────────────────────────
# Local dev: kubectl port-forward -n nats svc/nats-headless 8222:8222
# In-cluster: NATS_MONITOR_URL=http://nats-headless.nats.svc.cluster.local:8222
NATS_MONITOR_URL=http://localhost:8222

# ─── Chat tab (uses Claude Code Max subscription) ───────────────────────
# The /[tenant]/chat page spawns the `claude` CLI as a subprocess. It reads
# the OAuth token from this env var so it does NOT prompt interactively.
# Get one by running `claude` interactively at least once — token is stored
# in the OS keychain. To dump it: `claude auth token` (if available) or
# check ~/.config/claude/ files. NEVER commit the actual value.
CLAUDE_CODE_OAUTH_TOKEN=

# Setting ANTHROPIC_API_KEY to empty forces the CLI to use OAuth (Max sub)
# rather than a paid API key. Leave this blank.
ANTHROPIC_API_KEY=

# ─── GitOps writeback (primary: GitHub App OAuth) ───────────────────────
# Preferred flow: register the GitHub App once (jaredzwick or your org),
# put the Client ID here, and users sign in via the console (no PAT).
#
# To register the App:
#   1. https://github.com/settings/apps/new
#   2. Name: equity-console (or your fork)
#   3. Homepage URL: https://github.com/<owner>/equity-platform
#   4. Callback URL: (leave blank — device flow doesn't need one)
#   5. Uncheck "Webhook Active"
#   6. Repository permissions: Contents: R/W, Metadata: R
#   7. Save. Copy the Client ID.
#   8. Under "Optional features", enable "Device flow".
GITHUB_APP_CLIENT_ID=

# Target repo the console writes to. owner/name form. Users' console
# writes here — must be a repo they have installed the App on.
GITHUB_REPO=jaredzwick/equity-platform
GITHUB_BRANCH=main

# Iron-session cookie encryption password. Any 32+ char string. Change per
# deployment. For local dev you can leave blank (a fallback dev-only value
# is used — DO NOT ship production without setting this).
SESSION_PASSWORD=

# ─── Fallback / headless flow (optional) ────────────────────────────────
# If you can't use OAuth (CI, headless setup), fall back to a fine-grained
# PAT with Contents: R/W on the target repo. Set both this + GITHUB_REPO.
# Ignored when a signed-in session exists.
GITHUB_TOKEN=

# ─── Logo studio (OpenAI gpt-image-1) ───────────────────────────────────
# The /[tenant]/logo page uses OpenAI's image generation API. Each accepted
# logo is committed to businesses/<slug>/logo.png and referenced from the
# profile's brand.logo_url. Approx cost: $0.04–0.19 per image.
OPENAI_API_KEY=

# ─── Per-tenant email deliverability (auto-provisioned) ─────────────────
# ONE base URL for the whole platform — the console derives per-tenant
# database names as `equity_email_<slug>` and creates them on demand.
# Zero per-tenant config in the happy path.
#
# Local dev: point at a docker/kubectl-forwarded Postgres.
#   EMAIL_DB_BASE_URL=postgres://postgres:postgres@localhost:5432
# In-cluster: point at the platform Postgres Service.
#   EMAIL_DB_BASE_URL=postgres://postgres:$(cat pw)@postgres.email.svc.cluster.local:5432
EMAIL_DB_BASE_URL=

# Escape hatch: full per-tenant URL override. Wins over EMAIL_DB_BASE_URL
# when set. Useful for tenants that need their own isolated Postgres.
# EMAIL_DB_URL_PYPES=
# EMAIL_DB_URL_CJS=

# Resend webhook signing secret (Svix format). Same secret for all tenants;
# tenant is disambiguated by the URL path (/api/webhooks/resend/<slug>).
RESEND_WEBHOOK_SECRET=

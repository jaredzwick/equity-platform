{
  "//": "Copy to .mcp.json (which is gitignored). Registers the equity MCP so Claude Code (CLI and the console's /chat page) can call list_businesses / create_business / update_profile / create_cron. Env vars flow through from your shell + console/.env.local. Add your own personal MCPs (Notion, Gamma, etc.) to your local copy — this template ships equity-only.",
  "mcpServers": {
    "equity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tsx", "console/mcp/server.ts"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_REPO": "${GITHUB_REPO}",
        "GITHUB_BRANCH": "${GITHUB_BRANCH}",
        "KUBECONFIG": "${KUBECONFIG}",
        "CLAUDE_CODE_OAUTH_TOKEN": "${CLAUDE_CODE_OAUTH_TOKEN}"
      }
    }
  }
}
